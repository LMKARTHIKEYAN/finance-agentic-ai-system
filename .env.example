# Application Settings
APP_NAME=Finance Agentic AI System
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Project Paths
DATA_PATH=data
REPORT_PATH=reports
LOG_PATH=logs

# Database
FINANCE_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/finance_agentic_ai
POSTGRES_CONNECT_TIMEOUT_SECONDS=10

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
FINANCE_API_TIMEOUT_SECONDS=150

# Complex autonomous runtime (safe defaults)
LANGGRAPH_ENABLED=false
LANGGRAPH_SHADOW_MODE=true
LANGGRAPH_MAX_STEPS=8

# Finance data source
FINANCE_DATA_SOURCE=postgres

# Legacy Snowflake configuration (not used by the PostgreSQL runtime)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=FINANCE_AI_WH
SNOWFLAKE_DATABASE=FINANCE_AI
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_ROLE=FINANCE_AI_APP_ROLE
SNOWFLAKE_CONNECT_TIMEOUT_SECONDS=10
SNOWFLAKE_QUERY_TIMEOUT_SECONDS=30
